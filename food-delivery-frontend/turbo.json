{
    "$schema": "https://turbo.build/schema.json",
    "envMode": "loose",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                ".env"
            ],
            "outputs": [
                "dist/**"
            ]
        },
        "dev": {
            "cache": false,
            "persistent": true,
            "env": [
                "VITE_API_GATEWAY_URL"
            ]
        }
    }
}