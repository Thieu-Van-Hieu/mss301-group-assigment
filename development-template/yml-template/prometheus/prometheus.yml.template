global:
  scrape_interval: 5s # Cứ 5 giây đi gom data 1 lần

scrape_configs:
  - job_name: 'identity-service'
    metrics_path: '/actuator/prometheus'
    static_configs:
      # 🌟 Tự động lấy giá trị cổng từ biến IDENTITY_SERVICE_PORT trong file .env
      - targets: ['host.docker.internal:${IDENTITY_SERVICE_PORT}']

  - job_name: 'api-gateway'
    metrics_path: '/actuator/prometheus'
    static_configs:
      # 🌟 Tự động lấy giá trị cổng từ biến API_GATEWAY_PORT trong file .env
      - targets: ['host.docker.internal:${API_GATEWAY_PORT}']