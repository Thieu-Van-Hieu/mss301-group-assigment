{
    "annotations": {
        "list": []
    },
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "id": null,
    "links": [],
    "liveNow": true,
    "panels": [
        {
            "title": "1. Trạng Thái Sức Khỏe - Tổng Số Request / Giây",
            "type": "timeseries",
            "id": 1,
            "gridPos": {
                "h": 7,
                "w": 12,
                "x": 0,
                "y": 0
            },
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "Prometheus"
                    },
                    "editorMode": "code",
                    "expr": "sum(rate(http_server_requests_seconds_count{job=~\"$service\"}[5m])) by (job, uri, status)",
                    "legendFormat": "{{job}} - {{uri}} (Status: {{status}})",
                    "range": true,
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "smooth"
                    },
                    "unit": "reqps"
                }
            }
        },
        {
            "title": "2. Thời Gian Phản Hồi API (Latency - Càng thấp càng tốt)",
            "type": "timeseries",
            "id": 2,
            "gridPos": {
                "h": 7,
                "w": 12,
                "x": 12,
                "y": 0
            },
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "Prometheus"
                    },
                    "editorMode": "code",
                    "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=~\"$service\"}[5m])) by (le, job))",
                    "legendFormat": "{{job}} - 95% Requests dưới {{le}}s",
                    "range": true,
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "smooth"
                    },
                    "unit": "s"
                }
            }
        },
        {
            "title": "3. Bộ Nhớ Ứng Dụng (JVM Heap Memory Usage)",
            "type": "timeseries",
            "id": 3,
            "gridPos": {
                "h": 7,
                "w": 24,
                "x": 0,
                "y": 7
            },
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "Prometheus"
                    },
                    "editorMode": "code",
                    "expr": "jvm_memory_used_bytes{job=~\"$service\", area=\"heap\"}",
                    "legendFormat": "{{job}} - Đang Sử Dụng",
                    "range": true,
                    "refId": "A"
                },
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "Prometheus"
                    },
                    "editorMode": "code",
                    "expr": "jvm_memory_max_bytes{job=~\"$service\", area=\"heap\"}",
                    "legendFormat": "{{job}} - Tối Đa Cấp Phát",
                    "range": true,
                    "refId": "B"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "drawStyle": "line"
                    },
                    "unit": "bytes"
                }
            }
        },
        {
            "title": "4. Nhật Ký Tập Trung Động Theo Service Được Chọn (Logs từ Loki)",
            "type": "logs",
            "id": 4,
            "gridPos": {
                "h": 12,
                "w": 24,
                "x": 0,
                "y": 14
            },
            "datasource": {
                "type": "loki",
                "uid": "Loki"
            },
            "targets": [
                {
                    "datasource": {
                        "type": "loki",
                        "uid": "Loki"
                    },
                    "expr": "{container=~\"$service\"} |= \"\"",
                    "refId": "A"
                }
            ],
            "options": {
                "showLabels": true,
                "wrapLogMessage": true,
                "enableLogDetails": true,
                "sortOrder": "Descending"
            }
        }
    ],
    "refresh": "5s",
    "schemaVersion": 38,
    "style": "dark",
    "tags": [
        "food-delivery-microservices"
    ],
    "time": {
        "from": "now-15m",
        "to": "now"
    },
    "timepicker": {
        "refresh_intervals": [
            "5s",
            "10s",
            "30s"
        ]
    },
    "timezone": "browser",
    "title": "Food Delivery - Giám Sát Chi Tiết Toàn Bộ Hệ Thống",
    "uid": "food-delivery-services-uid",
    "templating": {
        "list": [
            {
                "current": {
                    "selected": true,
                    "value": ".*"
                },
                "hide": 0,
                "includeAll": false,
                "label": "Chọn Dịch Vụ:",
                "name": "service",
                "options": [
                    {
                        "selected": true,
                        "text": "All (Tất cả hệ thống)",
                        "value": ".*"
                    },
                    {
                        "selected": false,
                        "text": "Identity Service",
                        "value": ".*identity-service.*|.*IDENTITY-SERVICE.*"
                    },
                    {
                        "selected": false,
                        "text": "API Gateway",
                        "value": ".*api-gateway.*|.*API-GATEWAY.*"
                    },
                    {
                        "selected": false,
                        "text": "Keycloak Auth Server",
                        "value": ".*keycloak.*"
                    },
                    {
                        "selected": false,
                        "text": "Kafka Message Broker",
                        "value": ".*kafka.*"
                    }
                ],
                "query": ".*, .*identity-service.*|.*IDENTITY-SERVICE.*, .*api-gateway.*|.*API-GATEWAY.*, .*keycloak.*, .*kafka.*",
                "type": "custom"
            }
        ]
    },
    "version": 1
}